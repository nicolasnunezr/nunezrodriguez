---
import { experience } from "../data/experience";
import { formatDuration, formatMonthYear, monthsBetween } from "../lib/duration";

const today = new Date();
---

<section id="experience">
  <h2 class="mono">Experience</h2>
  {
    experience.map(({ company, logo, roles }) => {
      const first = roles.at(-1)!;
      const last = roles[0];
      return (
        <div class="org">
          <img class="lg" src={logo} alt="" width="30" height="30" />
          <div>
            <div class="line1">
              <span class="t">{company}</span>
              <span class="total" data-start={first.start} data-end={last.end}>
                {formatDuration(monthsBetween(first.start, last.end, today))}
              </span>
            </div>
            <ul class="roles">
              {roles.map((role) => (
                <li class:list={["role", { now: role.end === "present" }]}>
                  <span>{role.title}</span>
                  <span class="d">
                    {formatMonthYear(role.start)} – {formatMonthYear(role.end)} ·{" "}
                    <span class="dur" data-start={role.start} data-end={role.end}>
                      {formatDuration(monthsBetween(role.start, role.end, today))}
                    </span>
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      );
    })
  }
</section>

<script>
  import { formatDuration, monthsBetween, type YearMonth } from "../lib/duration";

  const today = new Date();
  for (const el of document.querySelectorAll<HTMLElement>("#experience [data-start]")) {
    const start = el.dataset.start as YearMonth;
    const end = el.dataset.end as YearMonth | "present";
    el.textContent = formatDuration(monthsBetween(start, end, today));
  }
</script>

<style>
  .roles {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    position: relative;
  }
  .roles::before {
    content: "";
    position: absolute;
    left: 3px;
    top: 14px;
    bottom: 16px;
    width: 1px;
    background: var(--line);
  }
  .role {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 6px 0 6px 20px;
    position: relative;
  }
  .role::before {
    content: "";
    position: absolute;
    left: 0;
    top: 13px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--bg);
    border: 1.3px solid #c9c7bf;
  }
  .role.now::before {
    background: var(--ink);
    border-color: var(--ink);
  }
  .total {
    color: var(--mute);
    font-size: 12.5px;
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    .role {
      flex-direction: column;
      gap: 0;
    }
  }
</style>
